# ===================================================================
# KTÜN Kariyer Portalı - Environment Variable Template (.env.example)
# IMPORTANT: DO NOT WRITE REAL SECRETS IN THIS FILE!
# ===================================================================

# Node & Server Environment
NODE_ENV=production
PORT=5173

# Frontend API Configuration
VITE_API_URL=https://api.kariyer.ktun.edu.tr
VITE_APP_ENV=production

# Backend ASP.NET Core Settings (Environment Injection)
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=YOUR_SECURE_256BIT_SECRET_KEY_GOES_HERE_MIN_32_CHARS
JWT_ISSUER=https://api.kariyer.ktun.edu.tr
JWT_AUDIENCE=https://kariyer.ktun.edu.tr

# Database Connection String
DEFAULT_CONNECTION_STRING=Server=your_production_db_server;Database=KtunCareerPortalDb;User Id=db_user;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;
